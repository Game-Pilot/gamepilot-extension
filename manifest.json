{
  "manifest_version": 3,
  "name": "GamePilot Local Agent",
  "version": "0.9.7",
  "description": "Agente local do MVP GamePilot para operar e monitorar uma aba do Huntera.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel", "alarms"],
  "side_panel": { "default_path": "popup.html" },
  "incognito": "split",
  "host_permissions": [
    "https://huntera.com.br/*",
    "https://gamepilot-api.iancosta.dev/*",
    "https://gamepilot-web.iancosta.dev/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:4317/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://huntera.com.br/*"],
      "js": ["socket-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://huntera.com.br/*"],
      "js": ["observed-analyzer.js", "economy-observation.js", "adapters/huntera.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Abrir painel lateral do GamePilot"
  }
}
